[Unit]
Description=Create and verify the Task API SQLite backup

[Service]
Type=oneshot
User=task-api
Group=task-api
WorkingDirectory=/opt/task-api/current
Environment=DATABASE_URL=sqlite:////var/lib/task-api/tasks.db
ExecStart=/opt/task-api/venv/bin/python -m app.backup create --directory /var/backups/task-api --keep 7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/task-api
